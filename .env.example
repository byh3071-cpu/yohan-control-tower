# 요한 관제탑 환경변수 — 이 파일을 .env.local 로 복사 후 NOTION_TOKEN 만 채우면 된다.
# (DB ID 들은 lib/sources.ts 에 기본값이 있어 보통 설정 불필요. 오버라이드만 여기서.)

# ── 필수 ──
# 노션 내부 통합(Internal Integration) 토큰. 인제스트 대상 12개 DB/페이지를 이 통합과 공유해야 함.
NOTION_TOKEN=

# ── 로컬 인프라(기본값이면 생략 가능) ──
QDRANT_URL=http://localhost:6333
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── 노션 DB/페이지 ID 오버라이드(선택) ──
# 기본값은 lib/sources.ts. 값이 바뀌면 아래에 채워 오버라이드.
# NOTION_AI_DICTIONARY_DB_ID=
# NOTION_PROTOCOL_DB_ID=
# NOTION_RULEBOOK_DB_ID=
# NOTION_SUMMARY_DB_ID=
# NOTION_KNOWLEDGE_HUB_DB_ID=
# NOTION_PERSON_DB_ID=
# NOTION_KEYWORD_DB_ID=
# NOTION_CONSTITUTION_PAGE_ID=
# NOTION_PREFERENCE_DB_ID=
# NOTION_EXECUTION_LOG_DB_ID=
# NOTION_RETROSPECT_DB_ID=
# NOTION_RESOURCE_DB_ID=
