# 요한 관제탑 환경변수 — 이 파일을 .env.local 로 복사한 뒤 로컬 경로와 필요한 토큰을 채운다.
# (DB ID 들은 lib/sources.ts 에 기본값이 있어 보통 설정 불필요. 오버라이드만 여기서.)

# ── 필수 ──
# yohan-brain 레포 절대경로. 이름에 OS가 들어 있어도 지식 웹앱(요한 OS)이 아니라 서랍 경로다.
# 예: C:\Users\Public\dev\yohan-ecosystem\yohan-brain
YOHAN_OS_ROOT=
# 예: C:\Users\Public\dev\yohan-ecosystem
YOHAN_REPOS_ROOT=
# 개인 일정·할일 Markdown 원장. 예: C:\Users\Public\dev\yohan-data\calendar
YOHAN_CALENDAR_ROOT=

# Focus Feed 지식 검토는 Control Tower 서버가 이 경로의 고정 CLI만 shell:false로 실행한다.
# 서비스 키는 yohan-mcp의 .env에만 두고 여기에 기록하지 않는다.
YOHAN_MCP_ROOT=

# 노션 내부 통합(Internal Integration) 토큰. 인제스트 대상 12개 DB/페이지를 이 통합과 공유해야 함.
NOTION_TOKEN=

# ── 로컬 인프라(기본값이면 생략 가능) ──
QDRANT_URL=http://localhost:6333
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3

# ── 노션 DB/페이지 ID 오버라이드(선택) ──
# 기본값은 lib/sources.ts. 값이 바뀌면 아래에 채워 오버라이드.
# NOTION_AI_DICTIONARY_DB_ID=
# NOTION_PROTOCOL_DB_ID=
# NOTION_RULEBOOK_DB_ID=
# NOTION_SUMMARY_DB_ID=
# NOTION_KNOWLEDGE_HUB_DB_ID=
# NOTION_PERSON_DB_ID=
# NOTION_KEYWORD_DB_ID=
# NOTION_CONSTITUTION_PAGE_ID=
# NOTION_PREFERENCE_DB_ID=
# NOTION_EXECUTION_LOG_DB_ID=
# NOTION_RETROSPECT_DB_ID=
# NOTION_RESOURCE_DB_ID=
